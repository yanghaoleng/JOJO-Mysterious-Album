# Server-side only. Never expose any key to browser code.
ARK_API_KEY=your_volcengine_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_LLM_MODEL=doubao-seed-2-0-mini-260428
ARK_IMAGE_MODEL=doubao-seedream-5-0-lite-260128
ARK_IMAGE_SIZE=4K
FISH_AUDIO_API_KEY=your_fish_audio_api_key

# Story v2 speech transport. These are separate from the Ark API key.
# Credentials stay on the server. The browser keeps a typed fallback if speech is unavailable.
VOLC_SPEECH_APP_ID=your_doubao_speech_app_id
VOLC_SPEECH_ACCESS_TOKEN=your_doubao_speech_access_token
VOLC_SPEECH_RESOURCE_ID=your_doubao_speech_resource_id
PET_TTS_PROVIDER=volc

# Optional Seed Audio / Doubao TTS migration fields.
VOLC_TTS_SPEAKER_ID=zh_female_cancan_mars_bigtts
VOLC_TTS_RESOURCE_ID=volc.service_type.10029

# Fish Audio public voice used by scripts/generate_voice.py.
FISH_AUDIO_REFERENCE_ID=564dc2631c624222a21864b17f3c66a8

# Anonymous identity (local Docker MySQL defaults are documented in README).
MYSQL_URL=mysql://root:root@127.0.0.1:3306/jojo_mysterious_album_dev
SESSION_TOKEN_PEPPER=replace_with_at_least_32_random_characters

# Read-only anonymous-user administration. Generate the hash with:
# .venv/bin/python tools/hash-admin-password.py
ADMIN_USERNAME=internal_admin
ADMIN_PASSWORD_HASH=replace_with_scrypt_hash
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters

# Optional unified API Key for Doubao end-to-end realtime voice (server only).
# Takes precedence over the legacy app-id/access-token pair.
VOLC_REALTIME_API_KEY=

# Self-hosted product analytics dashboard at /data.
# The local/default management password is 997118; override it in production.
DATA_ADMIN_PASSWORD=997118
DATA_SESSION_SECRET=replace_with_at_least_32_random_characters
ANALYTICS_DB_PATH=/var/lib/kindergrimm/analytics.db
